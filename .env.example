# Variáveis de ambiente de exemplo (valores fictícios para desenvolvimento local)
DB_PORT=3306
DB_NAME=player_contabilidade
DB_USERNAME=player_user
DB_PASSWORD=player_secret_password
DB_ROOT_PASSWORD=player_root_password
DB_URL=jdbc:mysql://localhost:3306/player_contabilidade?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
JWT_SECRET=player-contabilidade-back-secret-key-jwt-must-be-very-long-32-bytes-minimum
JWT_EXPIRATION_MS=1800000
# Armazenamento de Anexos
STORAGE_LOCATION=uploads

# CORS (origens permitidas separadas por vírgula)
CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost:*,http://127.0.0.1:*

# Portas para orquestração Docker Compose
BACKEND_PORT=8080
FRONTEND_PORT=8081

# Frontend (Flutter)
API_URL=http://localhost:8080


